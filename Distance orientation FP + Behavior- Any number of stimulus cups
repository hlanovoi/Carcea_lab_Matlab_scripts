%%%%% BINNING %%%%%%


if strcmp(binData, 'yes')
    % Initialize cell arrays to store binned data
    binnedSig = cell(numBins, 1);
    binnedRef = cell(numBins, 1);
    binnedTime = cell(numBins, 1);
    binnedOccupancy = cell(numBins, 1);

    for i = 1:numBins
        % Find indices for current bin
        binIndices = find(theTime >= binStart(i) & theTime < binEnd(i));
        
        % Store binned data
        binnedSig{i} = newSig(binIndices);
        binnedRef{i} = ref(binIndices);
        binnedTime{i} = theTime(binIndices);
        binnedOccupancy{i} = occupancy(binIndices); % Assuming occupancy data exists
    end

    % Process and save the signal and occupancy for each bin
    for i = 1:numBins
        % Perform analysis on each bin
        currentSig = binnedSig{i};
        currentRef = binnedRef{i};
        currentTime = binnedTime{i};
        currentOccupancy = binnedOccupancy{i};
        
        % Calculate mean and std of the signal in each bin
        meanSig = mean(currentSig);
        stdSig = std(currentSig);
        
        % Create table and save to CSV
        T = table(currentTime, currentSig, currentRef, currentOccupancy, 'VariableNames', {'Time', 'Signal', 'Reference', 'Occupancy'});
        csvFileName = fullfile(outFolder, sprintf('bin_%d.csv', i));
        writetable(T, csvFileName);
        
        fprintf('Bin %d: Mean Signal = %.2f, Std Signal = %.2f\n', i, meanSig, stdSig);
    end
else
    % Process the entire signal without binning
    meanSig = mean(newSig);
    stdSig = std(newSig);
    
    % Create table and save to CSV
    T = table(theTime, newSig, ref, 'VariableNames', {'Time', 'Signal', 'Reference', 'Occupancy'});
    csvFileName = fullfile(outFolder, 'no_bin.csv');
    writetable(T, csvFileName);
    
    fprintf('No binning: Mean Signal = %.2f, Std Signal = %.2f\n', meanSig, stdSig);
end
