        originalCumDataInSeconds = originalCumData / FS;
    else
        warning('No cumulative distance variable found (cumDistWithin). Using zeros.');
        originalCumDataInSeconds = zeros(size(originalTime));
    end
    
    % Resample cumulative time data (now in seconds)
    resampledT.(['CumTimeWithin_Cup' num2str(i) '_Sec']) = interp1(originalTime, originalCumDataInSeconds, targetTime, 'nearest', 'extrap');
end

% Add the z-scored signal data
if exist('newSig', 'var') && length(newSig) == length(originalTime)
    % Resample the signal to match our 25Hz timebase
    resampledT.ZscoredSignal = interp1(originalTime, newSig, targetTime, 'linear', 'extrap');
    
    % Add cumulative preference index if we have at least 2 cups
    if nCups >= 2
        % Calculate instantaneous preference at each time point
        dist1 = resampledT.DistanceFromCup1;
        dist2 = resampledT.DistanceFromCup2;
        
        % Avoid division by zero
        denominator = dist1 + dist2;
        denominator(denominator == 0) = 1e-10;
        
        % Calculate instantaneous preference
        instantPreference = (dist1 - dist2) ./ denominator;
        
        % Build cumulative preference index as running average
        cumulativePreference = cumsum(instantPreference);
        numSamples = 1:length(cumulativePreference);
        resampledT.CumulativePreferenceIndex = cumulativePreference ./ numSamples';
    end
end

