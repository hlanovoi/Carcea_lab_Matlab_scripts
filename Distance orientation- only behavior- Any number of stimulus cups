%% interpolate nan values !
% More robust interpolation
% Define a maximum plausible velocity (in cm/frame)
% Adjust this value based on your animal's typical movement speed
max_velocity_threshold = 5; 

% More robust interpolation with velocity filtering
for bpID=1:size(tracks,2)
    fprintf('\nProcessing body part %d\n', bpID);
    for xy=1:2
        tmp=tracks(:,bpID,xy);
        theNan=isnan(tmp);
        
        % Only attempt interpolation if at least some data exists
        if sum(~theNan) > 1  % Need at least 2 points for interpolation
            % First pass: detect implausible jumps (tracking errors)
            non_nan_indices = find(~theNan);
            non_nan_values = tmp(non_nan_indices);
            
            % Calculate frame-to-frame velocity (in position units per frame)
            if length(non_nan_indices) > 1
                velocities = abs(diff(non_nan_values)) ./ diff(non_nan_indices);
                
                % Find indices where velocity exceeds threshold
                jump_indices = find(velocities > max_velocity_threshold);
                
                if ~isempty(jump_indices)
                    fprintf('  Found %d implausible jumps for dimension %d\n', length(jump_indices), xy);
                    
                    % Mark the points after jumps as NaN (they're likely errors)
                    for j = 1:length(jump_indices)
                        jump_idx = non_nan_indices(jump_indices(j) + 1);
                        tmp(jump_idx) = NaN;
                    end
                    
                    % Update the NaN mask
                    theNan = isnan(tmp);
                end
            end
            
            % Now perform interpolation on cleaned data
            try
                newVec = tmp;
                non_nan_indices = find(~theNan);
                nan_indices = find(theNan);
                
                % Only interpolate NaNs that are between valid data points
                interp_indices = nan_indices(nan_indices > min(non_nan_indices) & ...
                                           nan_indices < max(non_nan_indices));
                
                if ~isempty(interp_indices)
                    newVec(interp_indices) = interp1(non_nan_indices, ...
                                                  tmp(non_nan_indices), ...
                                                  interp_indices, 'linear');
                end
                
                tracks(:,bpID,xy) = newVec;
            catch
                fprintf('  Could not interpolate for body part %d, dimension %d\n', bpID, xy);
            end
        else
            fprintf('  Insufficient data for interpolation: body part %d, dimension %d\n', bpID, xy);
        end
    end
end

