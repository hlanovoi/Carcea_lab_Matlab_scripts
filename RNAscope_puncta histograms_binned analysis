%% Transcript Detection 
% Run the scanner to find available transcripts
allTranscriptsFound = scanAvailableTranscripts(dataFolder, hoStr, coreTranscripts);
fprintf('\nTranscript scanner found: %s\n', strjoin(allTranscriptsFound, ', '));

% Check for additional transcripts
additionalTranscripts = setdiff(allTranscriptsFound, coreTranscripts);

if ~isempty(additionalTranscripts)
    fprintf('\nAdditional transcripts detected: %s\n', strjoin(additionalTranscripts, ', '));
    useAdditional = input('Would you like to include these in the analysis? (y/n): ', 's');
    
    if strcmpi(useAdditional, 'y')
        % Ask which ones to include
        fprintf('\nSelect additional transcripts to include:\n');
        includeAdditional = false(1, length(additionalTranscripts));
        
        for i = 1:length(additionalTranscripts)
            response = input(sprintf('%d. %s (y/n): ', i, additionalTranscripts{i}), 's');
            includeAdditional(i) = strcmpi(response, 'y');
        end
        
        % Add selected transcripts to the analysis list
        selectedAdditional = additionalTranscripts(includeAdditional);
        transcripts = [coreTranscripts, selectedAdditional];
        fprintf('Analysis will include: %s\n', strjoin(transcripts, ', '));
    else
        transcripts = coreTranscripts;
        fprintf('Using only core transcripts: %s\n', strjoin(transcripts, ', '));
    end
else
    transcripts = coreTranscripts;
    fprintf('No additional transcripts detected. Using core transcripts: %s\n', strjoin(transcripts, ', '));
end

