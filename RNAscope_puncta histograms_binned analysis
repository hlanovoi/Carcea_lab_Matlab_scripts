fprintf('\n===== GENERATING SIMPLIFIED CO-EXPRESSION ANALYSIS =====\n');

% Create output directory
simplifiedDir = [outFolder 'Simplified_CoExpression/'];
if ~isfolder(simplifiedDir); mkdir(simplifiedDir); end

% Get thresholds from analysis parameters
if isfield(analysisParams, 'thresholds')
    thresh_CFOS = analysisParams.thresholds.CFOS;
    thresh_OTR = analysisParams.thresholds.OTR;
    thresh_EP2 = analysisParams.thresholds.EP2;
else
    % Fallback defaults
    thresh_CFOS = 5;
    thresh_OTR = 5;
    thresh_EP2 = 5;
end

fprintf('Using thresholds: CFOS>%d, OTR>%d, EP2>%d\n', thresh_CFOS, thresh_OTR, thresh_EP2);

% Create output filename
outputFilename = [simplifiedDir 'Simplified_CoExpression_Analysis_thresh' ...
                  num2str(thresh_CFOS) '_' datestr(now, 'ddmmmyyyy') '.xlsx'];

% Initialize master data table
allData = table();
rowIdx = 1;

% Process each region
for rIdx = 1:length(analysisParams.regionsToProcess)
    rID = analysisParams.regionsToProcess(rIdx);
    
    fprintf('\nProcessing region: %s\n', regions{rID});
    
    % Collect all mice across all ranks and treatments
    allMice = [];
    for rankID = 1:4
        for treatID = 1:2
            if ~isempty(bigDat{rID,treatID,rankID}) && size(bigDat{rID,treatID,rankID}, 2) >= 6
                [a,~,~] = unique(bigDat{rID,treatID,rankID}(:,4:5),'rows');
                for m = 1:size(a,1)
                    allMice = [allMice; a(m,:), rankID, treatID];
                end
            end
        end
    end
    allMice = unique(allMice, 'rows');
    
    fprintf('  Found %d mice with data in this region\n', size(allMice,1));
    
    % Process each mouse
    for mouseIdx = 1:size(allMice,1)
        folderID = allMice(mouseIdx,1);
        fileID = allMice(mouseIdx,2);
        rankID = allMice(mouseIdx,3);
        treatID = allMice(mouseIdx,4);
        
        % Get mouse ID
        theFiles = dir([dataFolder hoStr{folderID} '*.csv']);
        if fileID <= length(theFiles)
            mouseID = theFiles(fileID).name(1:end-4);
        else
            mouseID = sprintf('Unknown_%d_%d', folderID, fileID);
            continue;
        end
        
        % Get this mouse's data (pooled across all sections)
        these = all(ismember(bigDat{rID,treatID,rankID}(:,4:5), allMice(mouseIdx,1:2)), 2);
        mouseData = bigDat{rID,treatID,rankID}(these,:);
        
        if isempty(mouseData) || size(mouseData, 2) < 3
            fprintf('    Skipping %s - insufficient data\n', mouseID);
            continue;
        end
        
        % Extract puncta counts for each transcript (pooled across all sections)
        cfos_counts = mouseData(:, 1);
        otr_counts = mouseData(:, 2);
        ep2_counts = mouseData(:, 3);
        
        total_cells = length(cfos_counts);
        
        if total_cells == 0
            fprintf('    Skipping %s - no cells\n', mouseID);
            continue;
        end
        
        fprintf('    Processing %s (Rank %d, %s) - %d total cells\n', ...
                mouseID, rankID, treatments{treatID}, total_cells);
        
        % === PART 1: SINGLE TRANSCRIPT EXPRESSION ===
        cfos_positive = cfos_counts > thresh_CFOS;
        otr_positive = otr_counts > thresh_OTR;
        ep2_positive = ep2_counts > thresh_EP2;
        
        num_cfos = sum(cfos_positive);
        num_otr = sum(otr_positive);
        num_ep2 = sum(ep2_positive);
        
        pct_cfos = (num_cfos / total_cells) * 100;
        pct_otr = (num_otr / total_cells) * 100;
        pct_ep2 = (num_ep2 / total_cells) * 100;
        
        % === PART 2: CONDITIONAL CO-EXPRESSION ===
        % (Of X+ cells, what % also express Y?)
        
        % CFOS with OTR
        cfos_and_otr = cfos_positive & otr_positive;
        if num_cfos > 0
            pct_cfos_with_otr = (sum(cfos_and_otr) / num_cfos) * 100;
        else
            pct_cfos_with_otr = NaN;
        end
        
        % CFOS with EP2
        cfos_and_ep2 = cfos_positive & ep2_positive;
        if num_cfos > 0
            pct_cfos_with_ep2 = (sum(cfos_and_ep2) / num_cfos) * 100;
        else
            pct_cfos_with_ep2 = NaN;
        end
        
        % OTR with CFOS
        if num_otr > 0
            pct_otr_with_cfos = (sum(cfos_and_otr) / num_otr) * 100;
        else
            pct_otr_with_cfos = NaN;
        end
        
        % OTR with EP2
        otr_and_ep2 = otr_positive & ep2_positive;
        if num_otr > 0
            pct_otr_with_ep2 = (sum(otr_and_ep2) / num_otr) * 100;
        else
            pct_otr_with_ep2 = NaN;
        end
        
        % EP2 with CFOS
        if num_ep2 > 0
            pct_ep2_with_cfos = (sum(cfos_and_ep2) / num_ep2) * 100;
        else
            pct_ep2_with_cfos = NaN;
        end
        
        % EP2 with OTR
        if num_ep2 > 0
            pct_ep2_with_otr = (sum(otr_and_ep2) / num_ep2) * 100;
        else
            pct_ep2_with_otr = NaN;
        end
        
        % === PART 3: CO-EXPRESSION AS % OF TOTAL ===
        pct_cfos_otr_total = (sum(cfos_and_otr) / total_cells) * 100;
        pct_cfos_ep2_total = (sum(cfos_and_ep2) / total_cells) * 100;
        pct_otr_ep2_total = (sum(otr_and_ep2) / total_cells) * 100;
        
        % Triple co-expression
        triple_positive = cfos_positive & otr_positive & ep2_positive;
        pct_triple_total = (sum(triple_positive) / total_cells) * 100;
        
        % === STORE IN TABLE ===
        allData.MouseID{rowIdx} = mouseID;
        allData.Region{rowIdx} = regions{rID};
        allData.Rank(rowIdx) = rankID;
        allData.Treatment{rowIdx} = treatments{treatID};
        allData.TotalCells(rowIdx) = total_cells;
        
        % Single expression
        allData.CFOS_Percent(rowIdx) = pct_cfos;
        allData.OTR_Percent(rowIdx) = pct_otr;
        allData.EP2_Percent(rowIdx) = pct_ep2;
        
        % Conditional co-expression
        allData.CFOS_with_OTR_Percent(rowIdx) = pct_cfos_with_otr;
        allData.CFOS_with_EP2_Percent(rowIdx) = pct_cfos_with_ep2;
        allData.OTR_with_CFOS_Percent(rowIdx) = pct_otr_with_cfos;
        allData.OTR_with_EP2_Percent(rowIdx) = pct_otr_with_ep2;
        allData.EP2_with_CFOS_Percent(rowIdx) = pct_ep2_with_cfos;
        allData.EP2_with_OTR_Percent(rowIdx) = pct_ep2_with_otr;
        
        % Co-expression as % of total
        allData.CFOS_OTR_of_Total(rowIdx) = pct_cfos_otr_total;
        allData.CFOS_EP2_of_Total(rowIdx) = pct_cfos_ep2_total;
        allData.OTR_EP2_of_Total(rowIdx) = pct_otr_ep2_total;
        allData.Triple_of_Total(rowIdx) = pct_triple_total;
        
        rowIdx = rowIdx + 1;
    end
end

% Write to Excel
if ~isempty(allData)
    writetable(allData, outputFilename, 'Sheet', 'All_Data');
    fprintf('\n===== SIMPLIFIED CO-EXPRESSION COMPLETE =====\n');
    fprintf('Wrote %d rows (mice × regions) to: %s\n', height(allData), outputFilename);
    fprintf('\nColumn descriptions:\n');
    fprintf('  Single Expression (%%): Cells with transcript >%d puncta\n', thresh_CFOS);
    fprintf('  Conditional Co-expression (%%): Of X+ cells, %% also Y+\n');
    fprintf('  Of Total (%%): Co-expressing cells as %% of all cells\n');
    fprintf('  Triple_of_Total: Cells expressing all 3 transcripts\n');
else
    fprintf('\nNo data to write!\n');
end

