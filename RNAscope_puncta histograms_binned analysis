    for i = 1:length(transcripts)
        % Get default value if exists, otherwise use 5
        if isfield(defaultThresholds, transcripts{i})
            defaultVal = defaultThresholds.(transcripts{i});
        else
            defaultVal = 5;
        end
        
        prompt = sprintf('Enter threshold for %s (default: %d): ', transcripts{i}, defaultVal);
        userInput = input(prompt);
        if ~isempty(userInput) && isnumeric(userInput)
            analysisParams.thresholds.(transcripts{i}) = userInput;
        else
            analysisParams.thresholds.(transcripts{i}) = defaultVal;
            fprintf('Using default value %d for %s\n', defaultVal, transcripts{i});
        end
    end
else
    % For default values, make sure we have a threshold for every transcript
    for i = 1:length(transcripts)
        if isfield(defaultThresholds, transcripts{i})
            analysisParams.thresholds.(transcripts{i}) = defaultThresholds.(transcripts{i});
        else
            analysisParams.thresholds.(transcripts{i}) = 5; % Default value
        end
