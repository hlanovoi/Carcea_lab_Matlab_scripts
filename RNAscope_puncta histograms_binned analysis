fprintf('Scanning data to determine required number of bins...\n');
maxPuncta = 0;
for rID = 1:size(bigDat, 1)
    for treatID = 1:size(bigDat, 2)
        for rankID = 1:size(bigDat, 3)
            if ~isempty(bigDat{rID,treatID,rankID}) && size(bigDat{rID,treatID,rankID}, 2) >= 3
                % Check max for each transcript
                for trID = 1:3
                    maxHere = max(bigDat{rID,treatID,rankID}(:, trID));
                    if maxHere > maxPuncta
                        maxPuncta = maxHere;
                    end
                end
            end
        end
    end
end

% Calculate number of bins needed (add 2 extra bins for safety)
maxBins = ceil(maxPuncta / binSize) + 2;
fprintf('Maximum puncta count found: %d\n', maxPuncta);
fprintf('Creating %d bins (up to %d puncta)\n', maxBins, maxBins*binSize);

% Create bin labels with non-overlapping ranges: 0-10, 11-20, 21-30, etc.
binLabels = cell(maxBins, 1);
for i = 1:maxBins
    if i == 1
        binLabels{i} = sprintf('0-%d', binSize);
    else
        binLabels{i} = sprintf('%d-%d', (i-1)*binSize + 1, i*binSize);
    end
end

% Define co-expression pairs to calculate
% Format: {primary_transcript_idx, secondary_transcript_idx, threshold_for_primary}
coexpPairs = {
    {1, 3, 'CFOS', 'EP2'},   % CFOS+ given EP2 puncta
    {1, 2, 'CFOS', 'OTR'},   % CFOS+ given OTR puncta
    {3, 1, 'EP2', 'CFOS'},   % EP2+ given CFOS puncta
    {3, 2, 'EP2', 'OTR'}     % EP2+ given OTR puncta
};

% Main export filename - includes bin size in name
outputFilename = [binnedDir 'Binned_Expression_' num2str(binSize) 'pBins_' datestr(now, 'ddmmmyyyy') '.xlsx'];

% Process each region
for rIdx = 1:length(analysisParams.regionsToProcess)
    rID = analysisParams.regionsToProcess(rIdx);
    
    fprintf('\nProcessing region: %s\n', regions{rID});
    
    % Initialize master tables for this region
    masterTable = table();
    masterCountsTable = table();
    rowCounter = 1;
    
    % Collect all mice across all ranks and treatments
    allMice = [];
    for rankID = 1:4
        for treatID = 1:2
            if ~isempty(bigDat{rID,treatID,rankID}) && size(bigDat{rID,treatID,rankID}, 2) >= 6
                [a,~,~] = unique(bigDat{rID,treatID,rankID}(:,4:5),'rows');
                for m = 1:size(a,1)
                    allMice = [allMice; a(m,:), rankID, treatID];
                end
            end
        end
    end
    allMice = unique(allMice, 'rows');
    
    fprintf('  Found %d mice with data in this region\n', size(allMice,1));
    
    % Process each mouse
    for mouseIdx = 1:size(allMice,1)
        folderID = allMice(mouseIdx,1);
        fileID = allMice(mouseIdx,2);
        rankID = allMice(mouseIdx,3);
        treatID = allMice(mouseIdx,4);
        
        % Get mouse ID
        theFiles = dir([dataFolder hoStr{folderID} '*.csv']);
        if fileID <= length(theFiles)
            mouseID = theFiles(fileID).name(1:end-4);
        else
            mouseID = sprintf('Unknown_%d_%d', folderID, fileID);
            continue;
        end
        
        % Get this mouse's data
        these = all(ismember(bigDat{rID,treatID,rankID}(:,4:5), allMice(mouseIdx,1:2)), 2);
        mouseData = bigDat{rID,treatID,rankID}(these,:);
        
        if isempty(mouseData)
            continue;
        end
        
        % Get unique sections for this mouse
        [sections,~,sectionIdx] = unique(mouseData(:,6));
        
        fprintf('    Processing %s (Rank %d, %s) - %d sections\n', ...
                mouseID, rankID, treatments{treatID}, length(sections));
        
        % Initialize data arrays for bins
        binData = nan(maxBins, 11); % Columns: bin center, 3 transcripts, 4 coexp, n_sections, rank, treatment
        binCounts = nan(maxBins, 8); % Raw counts: 3 transcripts, 4 coexp, total cells
        
        % === SINGLE TRANSCRIPT PROPORTIONS ===
        for trID = 1:3
            if trID > size(mouseData, 2) - 3
                continue;
            end
            
            % Calculate proportion in each bin for each section
            sectionProps = nan(length(sections), maxBins);
            sectionCounts = nan(length(sections), maxBins);
            
            for secID = 1:length(sections)
                sectionCells = mouseData(sectionIdx == secID, trID);
                
                % Bin the data (non-overlapping bins: 0-10, 11-20, 21-30, etc.)
                for binID = 1:maxBins
                    if binID == 1
                        binMin = 0;
                        binMax = binSize;
                        cellsInBin = sectionCells >= binMin & sectionCells <= binMax;
                    else
                        binMin = (binID-1) * binSize + 1;
                        binMax = binID * binSize;
                        cellsInBin = sectionCells >= binMin & sectionCells <= binMax;
                    end
                    
                    sectionCounts(secID, binID) = sum(cellsInBin);
                    if sum(cellsInBin) > 0
                        sectionProps(secID, binID) = sum(cellsInBin) / length(sectionCells);
                    end
                end
            end
            
            % Average across sections and convert to PERCENTAGE
            binData(:, trID+1) = mean(sectionProps, 1, 'omitnan')' * 100;
            binCounts(:, trID) = sum(sectionCounts, 1, 'omitnan')';
        end
        
        % === CO-EXPRESSION PROPORTIONS ===
        for pairIdx = 1:length(coexpPairs)
            pair = coexpPairs{pairIdx};
            primaryIdx = pair{1};
            secondaryIdx = pair{2};
            primaryName = pair{3};
            
            % Get threshold for primary transcript
            if isfield(analysisParams.thresholds, primaryName)
                threshold = analysisParams.thresholds.(primaryName);
            else
                threshold = 5;
            end
            
            % Check if we have the necessary columns
            if max(primaryIdx, secondaryIdx) > size(mouseData, 2) - 3
                continue;
            end
            
            % Calculate co-expression for each section
            sectionCoexp = nan(length(sections), maxBins);
            sectionCoexpCounts = nan(length(sections), maxBins);
            
            for secID = 1:length(sections)
                sectionCells = mouseData(sectionIdx == secID, :);
                primaryCounts = sectionCells(:, primaryIdx);
                secondaryCounts = sectionCells(:, secondaryIdx);
                
                % Bin by secondary transcript (non-overlapping bins)
                for binID = 1:maxBins
                    if binID == 1
                        binMin = 0;
                        binMax = binSize;
                        cellsInBin = secondaryCounts >= binMin & secondaryCounts <= binMax;
                    else
                        binMin = (binID-1) * binSize + 1;
                        binMax = binID * binSize;
                        cellsInBin = secondaryCounts >= binMin & secondaryCounts <= binMax;
                    end
                    
                    if sum(cellsInBin) > 0
                        primaryInBin = primaryCounts(cellsInBin);
                        numPositive = sum(primaryInBin > threshold);
                        coexpProp = numPositive / length(primaryInBin);
                        sectionCoexp(secID, binID) = coexpProp;
                        sectionCoexpCounts(secID, binID) = numPositive;
                    end
                end
            end
            
            % Average across sections and convert to PERCENTAGE
            binData(:, 4 + pairIdx) = mean(sectionCoexp, 1, 'omitnan')' * 100;
            binCounts(:, 3 + pairIdx) = sum(sectionCoexpCounts, 1, 'omitnan')';
        end
        
        % Add metadata
        binData(:, 9) = sum(~isnan(sectionProps), 1)'; % n_sections contributing to each bin
        binData(:, 10) = rankID;
        binData(:, 11) = treatID;
        
        % Create table for this mouse (simplified - only ID, bins, and expression data)
        % All values are in PERCENTAGE (0-100)
        mouseTable = table();
        mouseTable.MouseID = repmat({mouseID}, maxBins, 1);
        mouseTable.PunctaBin = binLabels;
        mouseTable.CFOS_Percent = binData(:, 2);
        mouseTable.OTR_Percent = binData(:, 3);
        mouseTable.EP2_Percent = binData(:, 4);
        mouseTable.CFOS_given_EP2_Percent = binData(:, 5);
        mouseTable.CFOS_given_OTR_Percent = binData(:, 6);
        mouseTable.EP2_given_CFOS_Percent = binData(:, 7);
        mouseTable.EP2_given_OTR_Percent = binData(:, 8);
        
        % Create counts table for this mouse
        mouseCountsTable = table();
        mouseCountsTable.MouseID = repmat({mouseID}, maxBins, 1);
        mouseCountsTable.PunctaBin = binLabels;
        mouseCountsTable.CFOS_Count = binCounts(:, 1);
        mouseCountsTable.OTR_Count = binCounts(:, 2);
        mouseCountsTable.EP2_Count = binCounts(:, 3);
        mouseCountsTable.CFOS_given_EP2_Count = binCounts(:, 4);
        mouseCountsTable.CFOS_given_OTR_Count = binCounts(:, 5);
        mouseCountsTable.EP2_given_CFOS_Count = binCounts(:, 6);
        mouseCountsTable.EP2_given_OTR_Count = binCounts(:, 7);
        
        % Append to master tables
        masterTable = [masterTable; mouseTable];
        masterCountsTable = [masterCountsTable; mouseCountsTable];
        
        % Add blank row between mice for readability
        if mouseIdx < size(allMice,1)
            blankRow = table();
            blankRow.MouseID = {''};
            blankRow.PunctaBin = {''};
            blankRow.CFOS_Percent = NaN;
            blankRow.OTR_Percent = NaN;
            blankRow.EP2_Percent = NaN;
            blankRow.CFOS_given_EP2_Percent = NaN;
            blankRow.CFOS_given_OTR_Percent = NaN;
            blankRow.EP2_given_CFOS_Percent = NaN;
            blankRow.EP2_given_OTR_Percent = NaN;
            masterTable = [masterTable; blankRow];
            
            % Counts blank row
            blankCountRow = table();
            blankCountRow.MouseID = {''};
            blankCountRow.PunctaBin = {''};
            blankCountRow.CFOS_Count = NaN;
            blankCountRow.OTR_Count = NaN;
            blankCountRow.EP2_Count = NaN;
            blankCountRow.CFOS_given_EP2_Count = NaN;
            blankCountRow.CFOS_given_OTR_Count = NaN;
            blankCountRow.EP2_given_CFOS_Count = NaN;
            blankCountRow.EP2_given_OTR_Count = NaN;
            masterCountsTable = [masterCountsTable; blankCountRow];
        end
    end  % End of mouseIdx loop (processing each mouse)
    
    % Write this region's data to Excel
    if ~isempty(masterTable)
        writetable(masterTable, outputFilename, 'Sheet', [regions{rID} '_Percent']);
        fprintf('  Wrote %d rows to sheet: %s_Percent\n', height(masterTable), regions{rID});
    else
        fprintf('  No data to write for region: %s\n', regions{rID});
    end
    
    % Write counts table
    if ~isempty(masterCountsTable)
        writetable(masterCountsTable, outputFilename, 'Sheet', [regions{rID} '_Counts']);
        fprintf('  Wrote %d rows to sheet: %s_Counts\n', height(masterCountsTable), regions{rID});
    end
end  % End of rIdx loop (processing each region)

fprintf('\n===== COMPLETED %d-PUNCTA BIN ANALYSIS =====\n', binSize);
fprintf('Output saved to: %s\n', outputFilename);

end  % End of binSizeIdx loop (processing each bin size)

fprintf('\n===== ALL BINNED ANALYSES COMPLETE =====\n');
fprintf('Generated files with %d and %d puncta bins\n', binSizes(1), binSizes(2));
fprintf('Output directory: %s\n', binnedDir);
fprintf('\nData organization:\n');
fprintf('  - Two files: one with %d-puncta bins, one with %d-puncta bins\n', binSizes(1), binSizes(2));
fprintf('  - Two sheets per region: _Percent and _Counts\n');
fprintf('  - Each mouse = one block of rows\n');
fprintf('  - PERCENT sheet: All values are percentages (0-100)\n');
fprintf('  - COUNTS sheet: Raw cell counts\n');
fprintf('  - Bins are non-overlapping (e.g., 0-10, 11-20, 21-30)\n');

